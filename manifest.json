{
  "manifest_version": 3,
  "name": "Tabs Copier",
  "version": "1.0",
  "description": "Extract URLs of all open tabs",
  "permissions": ["tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
